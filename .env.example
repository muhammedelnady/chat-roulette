# Chat Roulette — Environment Template (Safe Public Defaults)
# Copy to `.env` only if overriding local development settings.
# Never commit `.env` or real secrets to version control.

# Runtime transport mode: `simulated` (default, zero-backend showcase) or `socket`
EXPO_PUBLIC_CHAT_MODE=simulated

# Optional Socket.IO / REST endpoint when EXPO_PUBLIC_CHAT_MODE=socket
EXPO_PUBLIC_API_URL=http://localhost:3000

# Target environment: development | staging | production
EXPO_PUBLIC_ENV=development

# URL scheme for deep linking
EXPO_PUBLIC_APP_SCHEME=chatroulette

# Optional MMKV encryption key override (>= 32 chars in production builds)
EXPO_PUBLIC_MMKV_ENCRYPTION_KEY=
