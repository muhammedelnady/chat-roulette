{
  "name": "chat-roulette",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "e2e:ios": "argent e2e run .argent/e2e --recursive --platform ios",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "EXPO_NO_TELEMETRY=1 expo lint",
    "lint:fix": "EXPO_NO_TELEMETRY=1 expo lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=4 --no-watchman --silent",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:architecture": "bash ./scripts/verify-architecture.sh",
    "test:result-pattern": "bash ./scripts/verify-result-pattern.sh",
    "test:di": "bash ./scripts/verify-di.sh",
    "validate:i18n": "node scripts/validate-i18n.js",
    "i18n:check": "node scripts/validate-i18n.js",
    "check:symmetry": "node scripts/check-symmetry.mjs",
    "secret:scan": "bash scripts/secret-scan.sh",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run i18n:check && npm run test:architecture && npm run test:di && npm run test:result-pattern && npm run check:symmetry && npm run test:coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@csark0812/zustand-expo-devtools": "^2.1.8",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "axios": "^1.13.2",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-logs": "^5.5.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-private-property-in-object": "^7.29.7",
    "@eslint/js": "^9.39.2",
    "@swmansion/argent": "^0.34.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "fast-check": "^4.6.0",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "lint-staged": "^16.4.0",
    "prettier": "^3.2.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
